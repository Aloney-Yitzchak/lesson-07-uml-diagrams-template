<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5"
    tools:context=".MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛒 Shopping List App"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2c3e50"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add New Item"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#34495e"
            android:layout_marginBottom="8dp" />

        <!-- Item Name Input -->
        <EditText
            android:id="@+id/itemNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item name (e.g., Milk)"
            android:inputType="text"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:background="#ecf0f1"
            android:textColorHint="#95a5a6" />

        <!-- Quantity Input -->
        <EditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantity (e.g., 2)"
            android:inputType="number"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:background="#ecf0f1"
            android:textColorHint="#95a5a6" />

        <!-- Add Button -->
        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Add Item"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#27ae60"
            android:textColor="@android:color/white"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- List Display Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shopping List"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#34495e"
            android:layout_marginBottom="8dp" />

        <!-- List Display TextView -->
        <TextView
            android:id="@+id/listDisplay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No items yet. Add one!"
            android:textSize="13sp"
            android:textColor="#2c3e50"
            android:padding="8dp"
            android:background="#f8f9fa"
            android:scrollbars="vertical" />

    </LinearLayout>

    <!-- Clear Button -->
    <Button
        android:id="@+id/clearButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Clear All"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#e74c3c"
        android:textColor="@android:color/white" />

</LinearLayout>
